# Copy to .env before running any service.
# Every variable the system reads is listed here; see Appendix B of the spec.

# --- shared (all services) ---
NODE_ENV=development
LOG_LEVEL=debug

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-pipeline
SCHEMA_REGISTRY_URL=http://localhost:8081
TOPIC_PREFIX=orders

# --- producer (phase 3) ---
# Emission rate in messages per second. Fractional values are allowed.
PRODUCER_RATE_PER_SEC=5
# The key space: each product hashes to one partition (design decision D1).
PRODUCER_PRODUCTS=Item1,Item2,Item3,Item4,Item5
PRODUCER_MIN_PRICE=1
PRODUCER_MAX_PRICE=500
# Stop after this many messages. Leave unset to run until interrupted.
# PRODUCER_MAX_MESSAGES=100

# --- fault injection (phase 3, design decision D8) ---
# Master switch. Off means every record is a valid order.
CHAOS_MODE=false
# Share of records emitted with the transient-failure marker product,
# which the consumer retries and eventually succeeds on.
CHAOS_TRANSIENT_RATE=0.15
# Share of records emitted as undecodable bytes, which go straight to the DLQ.
CHAOS_POISON_RATE=0.05

# --- consumer (phase 4) ---
# Instances sharing a group id split the partitions between them; start a
# second instance with the same id to watch the rebalance.
CONSUMER_GROUP_ID=order-consumers
# Where a group with no committed offset starts: earliest (replay) or latest.
# Once a commit exists it always wins, which is what makes restart-and-resume work.
CONSUMER_AUTO_OFFSET_RESET=earliest
# REST API, WebSocket and dashboard (phase 5). A second instance on the same
# machine needs a different port, e.g. CONSUMER_API_PORT=3001.
CONSUMER_API_PORT=3000
CONSUMER_API_HOST=127.0.0.1
# How often consumer lag and topic depths are sampled for the dashboard.
CONSUMER_STATS_INTERVAL_MS=2000

# --- retry (phase 6, design decision D5) ---
# Stage 1: in-place attempts and the elapsed budget that bounds them. The
# budget is what keeps the handler well inside max.poll.interval.ms.
CONSUMER_RETRY_INPLACE_ATTEMPTS=3
CONSUMER_RETRY_INPLACE_BUDGET_MS=2000
# Stage 2 delays are fixed by the topic names: orders.retry.5s / 30s / 5m.

# The delivery on which the __TRANSIENT_FAIL__ chaos marker succeeds.
# 2 = fails once, recovers from the 5s tier. 4 = rides every tier, succeeds
# after the 5m one. 5 or more = exhausted (dead-lettered from phase 7).
CONSUMER_CHAOS_TRANSIENT_SUCCEED_AFTER=2

# --- dlq-inspector (phase 7) ---
# No extra variables: the CLI reads the shared settings above.
#   npm run dlq -- list [--limit N] [--json]
#   npm run dlq -- decode <offset> [--json]
#   npm run dlq -- replay <offset>... | --all | --from A [--to B] [--dry-run] [--json]
