{
  "type": "record",
  "namespace": "com.assignment.orders",
  "name": "Order",
  "doc": "A single purchase transaction as defined by the assignment specification.",
  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "doc": "Unique identifier for the order, e.g. \"1001\"."
    },
    {
      "name": "product",
      "type": "string",
      "doc": "Name of the purchased item, e.g. \"Item1\". Used as the Kafka message key."
    },
    {
      "name": "price",
      "type": "float",
      "doc": "Price of the product. 32-bit as specified; aggregation widens to double internally."
    }
  ]
}
